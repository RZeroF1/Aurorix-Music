<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Aurorix.Windows.Home.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Aurorix.Windows.Home"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Foreground" Value="#273038" />
        </Style>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="19" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#273038" />
        </Style>
        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource AurorixCanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="104" />
        </Grid.RowDefinitions>

        <!-- Sidebar: navigation is a host surface. Its commands will later bind
             to the shell facade without moving page ownership into the UI. -->
        <Border
            Grid.RowSpan="3"
            Grid.Column="0"
            Margin="12,10,8,12"
            Padding="12"
            Background="#E9FFFFFF"
            BorderBrush="#B8FFFFFF"
            BorderThickness="1"
            CornerRadius="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="54" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="34"
                        Height="34"
                        Background="#20282D"
                        CornerRadius="17">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="17"
                            Foreground="White"
                            Text="&#xE767;" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#172026" Text="Aurorix" />
                        <TextBlock FontSize="11" Foreground="#7A848A" Text="流光 · HiFi" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        Style="{StaticResource IconButtonStyle}"
                        AutomationProperties.Name="折叠导航"
                        ToolTipService.ToolTip="折叠导航">
                        <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE700;" />
                    </Button>
                </Grid>

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Hidden">
                    <StackPanel Spacing="3">
                        <Button Style="{StaticResource NavButtonStyle}" Background="#18282D2F">
                            <StackPanel Orientation="Horizontal" Spacing="13">
                                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="17" Glyph="&#xE80F;" />
                                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="首页" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="13">
                                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="17" Glyph="&#xE8B7;" />
                                <TextBlock VerticalAlignment="Center" FontSize="13" Text="音乐库" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="13">
                                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="17" Glyph="&#xE721;" />
                                <TextBlock VerticalAlignment="Center" FontSize="13" Text="搜索" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="13">
                                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="17" Glyph="&#xE8FD;" />
                                <TextBlock VerticalAlignment="Center" FontSize="13" Text="歌单" />
                            </StackPanel>
                        </Button>

                        <Border Height="1" Margin="8,11" Background="#281B2529" />

                        <Button Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="13">
                                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="17" Glyph="&#xE734;" />
                                <TextBlock VerticalAlignment="Center" FontSize="13" Text="我的收藏" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="13">
                                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="17" Glyph="&#xE823;" />
                                <TextBlock VerticalAlignment="Center" FontSize="13" Text="最近播放" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="13">
                                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="17" Glyph="&#xE896;" />
                                <TextBlock VerticalAlignment="Center" FontSize="13" Text="下载管理" />
                            </StackPanel>
                        </Button>

                        <Border Height="1" Margin="8,11" Background="#281B2529" />

                        <Button Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="13">
                                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="17" Glyph="&#xE8D7;" />
                                <TextBlock VerticalAlignment="Center" FontSize="13" Text="音源中心" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="13">
                                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="17" Glyph="&#xE74C;" />
                                <TextBlock VerticalAlignment="Center" FontSize="13" Text="插件中心" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="13">
                                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="17" Glyph="&#xE9D9;" />
                                <TextBlock VerticalAlignment="Center" FontSize="13" Text="统计中心" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2">
                    <Border Height="1" Margin="8,0,8,10" Background="#281B2529" />
                    <Button Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="13">
                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="17" Glyph="&#xE713;" />
                            <TextBlock VerticalAlignment="Center" FontSize="13" Text="设置" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Header -->
        <Grid Grid.Row="0" Grid.Column="1" Margin="28,8,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Name="SearchBox"
                Width="520"
                Height="42"
                HorizontalAlignment="Left"
                PlaceholderText="搜索歌曲、专辑、艺术家、歌词、歌单..."
                AutomationProperties.Name="全局搜索"
                QuerySubmitted="SearchBox_QuerySubmitted">
                <AutoSuggestBox.QueryIcon>
                    <SymbolIcon Symbol="Find" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="通知" ToolTipService.ToolTip="通知">
                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="17" Glyph="&#xE7F4;" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="主题" ToolTipService.ToolTip="主题">
                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="17" Glyph="&#xE790;" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="账户" ToolTipService.ToolTip="账户">
                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="18" Glyph="&#xE77B;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Scrollable page body -->
        <ScrollViewer
            Grid.Row="1"
            Grid.Column="1"
            Padding="28,12,24,28"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="27">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="30" FontWeight="SemiBold" Foreground="#172026" Text="Good Morning, Aurorix" />
                        <TextBlock Margin="0,5,0,0" FontSize="13" Foreground="#647078" Text="准备好享受今天的音乐了吗？" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Height="36"
                        Margin="0,5,0,0"
                        Padding="14,0"
                        Background="#A8FFFFFF"
                        BorderBrush="#501B2529"
                        BorderThickness="1"
                        CornerRadius="9"
                        Foreground="#273038"
                        Command="{x:Bind ViewModel.CustomizeHomeCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="13" Glyph="&#xE70F;" />
                            <TextBlock FontSize="12" Text="自定义首页" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Quick entries are a stable visual slot for future facade/plugin contributions. -->
                <StackPanel Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#172026" Text="快速入口" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Width="142" Height="110" Style="{StaticResource CardButtonStyle}" Command="{x:Bind ViewModel.OpenQuickEntryCommand}" CommandParameter="{x:Bind ViewModel.QuickEntries[0]}">
                                <Border Padding="12" Background="#F4FFFFFF" BorderBrush="#4BFFFFFF" BorderThickness="1" CornerRadius="14">
                                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                                        <Border Width="42" Height="42" Background="#E7F1ED" CornerRadius="21">
                                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#315F58" Glyph="&#xE734;" />
                                        </Border>
                                        <TextBlock HorizontalAlignment="Center" FontSize="12" Text="我喜欢的音乐" />
                                        <TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="#7A848A" Text="128 首歌" />
                                    </StackPanel>
                                </Border>
                            </Button>
                            <Button Width="142" Height="110" Style="{StaticResource CardButtonStyle}" Command="{x:Bind ViewModel.OpenQuickEntryCommand}" CommandParameter="{x:Bind ViewModel.QuickEntries[1]}">
                                <Border Padding="12" Background="#F4FFFFFF" BorderBrush="#4BFFFFFF" BorderThickness="1" CornerRadius="14">
                                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                                        <Border Width="42" Height="42" Background="#E9EEF7" CornerRadius="21">
                                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#4F658A" Glyph="&#xE823;" />
                                        </Border>
                                        <TextBlock HorizontalAlignment="Center" FontSize="12" Text="最近播放" />
                                        <TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="#7A848A" Text="356 首歌" />
                                    </StackPanel>
                                </Border>
                            </Button>
                            <Button Width="142" Height="110" Style="{StaticResource CardButtonStyle}" Command="{x:Bind ViewModel.OpenQuickEntryCommand}" CommandParameter="{x:Bind ViewModel.QuickEntries[2]}">
                                <Border Padding="12" Background="#F4FFFFFF" BorderBrush="#4BFFFFFF" BorderThickness="1" CornerRadius="14">
                                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                                        <Border Width="42" Height="42" Background="#F6ECE0" CornerRadius="21">
                                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#876640" Glyph="&#xE896;" />
                                        </Border>
                                        <TextBlock HorizontalAlignment="Center" FontSize="12" Text="下载管理" />
                                        <TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="#7A848A" Text="42 首歌" />
                                    </StackPanel>
                                </Border>
                            </Button>
                            <Button Width="142" Height="110" Style="{StaticResource CardButtonStyle}" Command="{x:Bind ViewModel.OpenQuickEntryCommand}" CommandParameter="{x:Bind ViewModel.QuickEntries[3]}">
                                <Border Padding="12" Background="#F4FFFFFF" BorderBrush="#4BFFFFFF" BorderThickness="1" CornerRadius="14">
                                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                                        <Border Width="42" Height="42" Background="#F0E8F2" CornerRadius="21">
                                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#78547F" Glyph="&#xE8D6;" />
                                        </Border>
                                        <TextBlock HorizontalAlignment="Center" FontSize="12" Text="我的歌单" />
                                        <TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="#7A848A" Text="8 个歌单" />
                                    </StackPanel>
                                </Border>
                            </Button>
                            <Button Width="142" Height="110" Style="{StaticResource CardButtonStyle}" Command="{x:Bind ViewModel.OpenQuickEntryCommand}" CommandParameter="{x:Bind ViewModel.QuickEntries[4]}">
                                <Border Padding="12" Background="#30FFFFFF" BorderBrush="#6C737A" BorderThickness="1" CornerRadius="14">
                                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                                        <Border Width="42" Height="42" Background="Transparent" CornerRadius="21">
                                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#667178" Glyph="&#xE710;" />
                                        </Border>
                                        <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="#667178" Text="自定义" />
                                        <TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="Transparent" Text="占位" />
                                    </StackPanel>
                                </Border>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>

                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#172026" Text="最近播放" />
                        <Button HorizontalAlignment="Right" Padding="8,0" Background="Transparent" BorderThickness="0" Foreground="#647078" Command="{x:Bind ViewModel.OpenAllRecentCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock FontSize="12" Text="全部" />
                                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="11" Glyph="&#xE72A;" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Width="164" Style="{StaticResource CardButtonStyle}" Command="{x:Bind ViewModel.PlayTrackCommand}" CommandParameter="{x:Bind ViewModel.RecentTracks[0]}">
                                <StackPanel Spacing="8">
                                    <Grid Width="164" Height="120">
                                        <Border Background="#87928D" CornerRadius="11" />
                                        <Ellipse Width="85" Height="85" HorizontalAlignment="Left" Margin="15,10,0,0" Fill="#B7C1BB" />
                                        <Ellipse Width="48" Height="48" HorizontalAlignment="Right" Margin="0,0,15,12" Fill="#556561" />
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Symbol" FontSize="38" Foreground="#E8EFEB" Text="♫" />
                                        <Border Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" Background="#F5FFFFFF" CornerRadius="15">
                                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#172026" Glyph="&#xE768;" />
                                        </Border>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="夜的第七章" />
                                        <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="#69747A" Text="周杰伦 · 叶惠美" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Width="164" Style="{StaticResource CardButtonStyle}" Command="{x:Bind ViewModel.PlayTrackCommand}" CommandParameter="{x:Bind ViewModel.RecentTracks[1]}">
                                <StackPanel Spacing="8">
                                    <Grid Width="164" Height="120">
                                        <Border Background="#252B30" CornerRadius="11" />
                                        <Ellipse Width="86" Height="86" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#4D5657" />
                                        <Ellipse Width="47" Height="47" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#111519" />
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Symbol" FontSize="29" Foreground="#E2E8E5" Text="♫" />
                                        <Border Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" Background="#F5FFFFFF" CornerRadius="15">
                                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#172026" Glyph="&#xE768;" />
                                        </Border>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="温柔星球" />
                                        <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="#69747A" Text="小王子" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Width="164" Style="{StaticResource CardButtonStyle}" Command="{x:Bind ViewModel.PlayTrackCommand}" CommandParameter="{x:Bind ViewModel.RecentTracks[2]}">
                                <StackPanel Spacing="8">
                                    <Grid Width="164" Height="120">
                                        <Border Background="#72738E" CornerRadius="11" />
                                        <Ellipse Width="105" Height="63" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-5,0,0,12" Fill="#4B5872" />
                                        <Ellipse Width="80" Height="80" HorizontalAlignment="Right" Margin="0,6,20,0" Fill="#A5A6BB" />
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="23" FontWeight="Bold" Foreground="#EFF0F7" Text="R" />
                                        <Border Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" Background="#F5FFFFFF" CornerRadius="15">
                                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#172026" Glyph="&#xE768;" />
                                        </Border>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="Renaissance" />
                                        <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="#69747A" Text="Beyonce" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Width="164" Style="{StaticResource CardButtonStyle}" Command="{x:Bind ViewModel.PlayTrackCommand}" CommandParameter="{x:Bind ViewModel.RecentTracks[3]}">
                                <StackPanel Spacing="8">
                                    <Grid Width="164" Height="120">
                                        <Border Background="#554A3B" CornerRadius="11" />
                                        <Ellipse Width="75" Height="92" HorizontalAlignment="Left" Margin="17,0,0,0" Fill="#B18C61" />
                                        <Ellipse Width="68" Height="82" HorizontalAlignment="Right" Margin="0,13,12,0" Fill="#273B3E" />
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="26" Foreground="#E6D6BC" Text="♪" />
                                        <Border Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" Background="#F5FFFFFF" CornerRadius="15">
                                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#172026" Glyph="&#xE768;" />
                                        </Border>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="我明日的梦" />
                                        <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="#69747A" Text="RADWIMPS" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Width="164" Style="{StaticResource CardButtonStyle}" Command="{x:Bind ViewModel.PlayTrackCommand}" CommandParameter="{x:Bind ViewModel.RecentTracks[4]}">
                                <StackPanel Spacing="8">
                                    <Grid Width="164" Height="120">
                                        <Border Background="#A66B2E" CornerRadius="11" />
                                        <Ellipse Width="125" Height="58" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-2,0,0,12" Fill="#DC9A42" />
                                        <Ellipse Width="82" Height="82" HorizontalAlignment="Right" Margin="0,5,21,0" Fill="#F0B45B" />
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" FontWeight="SemiBold" Foreground="#FFF1CF" Text="H" />
                                        <Border Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" Background="#F5FFFFFF" CornerRadius="15">
                                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#172026" Glyph="&#xE768;" />
                                        </Border>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="Hotel California" />
                                        <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="#69747A" Text="Eagles" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>

                <!-- Recommendation cards keep a broad contribution slot for future local/provider feeds. -->
                <StackPanel Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#172026" Text="为你推荐" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" MinHeight="82" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Command="{x:Bind ViewModel.OpenRecommendationCommand}" CommandParameter="{x:Bind ViewModel.Recommendations[0]}">
                          <Border Padding="14" Background="#D6FFFFFF" BorderBrush="#54FFFFFF" BorderThickness="1" CornerRadius="13">
                            <Grid>
                                <StackPanel>
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="每日推荐" />
                                    <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="#69747A" Text="根据你的听歌习惯生成" />
                                </StackPanel>
                                <Button Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="0" Background="#F0FFFFFF" BorderBrush="#501B2529" BorderThickness="1" CornerRadius="14" AutomationProperties.Name="播放每日推荐">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE768;" />
                                </Button>
                            </Grid>
                          </Border>
                        </Button>
                        <Button Grid.Column="1" MinHeight="82" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Command="{x:Bind ViewModel.OpenRecommendationCommand}" CommandParameter="{x:Bind ViewModel.Recommendations[1]}">
                          <Border Padding="14" Background="#D6FFFFFF" BorderBrush="#54FFFFFF" BorderThickness="1" CornerRadius="13">
                            <Grid>
                                <StackPanel>
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="新歌速递" />
                                    <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="#69747A" Text="最近发布的热门新歌" />
                                </StackPanel>
                                <Button Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="0" Background="#F0FFFFFF" BorderBrush="#501B2529" BorderThickness="1" CornerRadius="14" AutomationProperties.Name="播放新歌速递">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE768;" />
                                </Button>
                            </Grid>
                          </Border>
                        </Button>
                        <Button Grid.Column="2" MinHeight="82" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Command="{x:Bind ViewModel.OpenRecommendationCommand}" CommandParameter="{x:Bind ViewModel.Recommendations[2]}">
                          <Border Padding="14" Background="#D6FFFFFF" BorderBrush="#54FFFFFF" BorderThickness="1" CornerRadius="13">
                            <Grid>
                                <StackPanel>
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="氛围电台" />
                                    <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="#69747A" Text="围绕你的心情推荐" />
                                </StackPanel>
                                <Button Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="0" Background="#F0FFFFFF" BorderBrush="#501B2529" BorderThickness="1" CornerRadius="14" AutomationProperties.Name="播放氛围电台">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE768;" />
                                </Button>
                            </Grid>
                          </Border>
                        </Button>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Mini Player: the shell only presents playback state; no queue or clock
             logic belongs in this visual layer. -->
        <Border
            Grid.Row="2"
            Grid.Column="1"
            Margin="18,0,24,12"
            Padding="18,12"
            Background="#F2FFFFFF"
            BorderBrush="#84FFFFFF"
            BorderThickness="1"
            CornerRadius="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="210" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" Background="#899893" CornerRadius="10">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Symbol" FontSize="25" Foreground="#E7EFEB" Text="♫" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="夜的第七章" />
                        <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="#69747A" Text="周杰伦 · 叶惠美" />
                        <Border HorizontalAlignment="Left" Margin="0,5,0,0" Padding="6,2" Background="#E7EEEB" CornerRadius="4">
                            <TextBlock FontSize="9" Foreground="#49615A" Text="FLAC  24bit / 96kHz" />
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="1" Margin="22,0,22,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="10" Foreground="#69747A" Text="01:28" />
                        <ProgressBar Grid.Column="1" Height="3" Margin="0,6" Maximum="100" Value="38" />
                        <TextBlock Grid.Column="2" FontSize="10" Foreground="#69747A" Text="04:45" />
                    </Grid>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="19">
                        <Button Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="随机播放" ToolTipService.ToolTip="随机播放">
                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE8B1;" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="上一首" ToolTipService.ToolTip="上一首">
                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="17" Glyph="&#xE892;" />
                        </Button>
                        <Button Width="42" Height="42" Padding="0" Background="#18282D2F" BorderBrush="#421B2529" BorderThickness="1" CornerRadius="21" AutomationProperties.Name="播放">
                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE768;" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="下一首" ToolTipService.ToolTip="下一首">
                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="17" Glyph="&#xE893;" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="循环播放" ToolTipService.ToolTip="循环播放">
                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE8EE;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="11">
                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#273038" Glyph="&#xE767;" />
                    <Slider Width="74" Minimum="0" Maximum="100" Value="72" AutomationProperties.Name="音量" />
                    <Button Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="输出设备" ToolTipService.ToolTip="输出设备">
                        <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE7F5;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
