<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Semantic colors. The host may replace these values after a system or
         local theme change; pages should consume semantic keys, not material
         implementation details. -->
    <Color x:Key="Aurorix.Theme.Color.Canvas">#DDF1F3</Color>
    <Color x:Key="Aurorix.Theme.Color.Surface">#F2FFFFFF</Color>
    <Color x:Key="Aurorix.Theme.Color.SurfaceSubtle">#EAF3F1</Color>
    <Color x:Key="Aurorix.Theme.Color.Ink">#172026</Color>
    <Color x:Key="Aurorix.Theme.Color.MutedInk">#647078</Color>
    <Color x:Key="Aurorix.Theme.Color.Border">#841B2529</Color>
    <Color x:Key="Aurorix.Theme.Color.Accent">#315F58</Color>
    <Color x:Key="Aurorix.Theme.Color.OnAccent">#FFFFFFFF</Color>
    <Color x:Key="Aurorix.Theme.Color.Focus">#147A6D</Color>
    <Color x:Key="Aurorix.Theme.Color.Selection">#5C76B7AA</Color>
    <Color x:Key="Aurorix.Theme.Color.Disabled">#7A879095</Color>

    <SolidColorBrush x:Key="Aurorix.Theme.Brush.Canvas" Color="{StaticResource Aurorix.Theme.Color.Canvas}" />
    <SolidColorBrush x:Key="Aurorix.Theme.Brush.Surface" Color="{StaticResource Aurorix.Theme.Color.Surface}" />
    <SolidColorBrush x:Key="Aurorix.Theme.Brush.SurfaceSubtle" Color="{StaticResource Aurorix.Theme.Color.SurfaceSubtle}" />
    <SolidColorBrush x:Key="Aurorix.Theme.Brush.Ink" Color="{StaticResource Aurorix.Theme.Color.Ink}" />
    <SolidColorBrush x:Key="Aurorix.Theme.Brush.MutedInk" Color="{StaticResource Aurorix.Theme.Color.MutedInk}" />
    <SolidColorBrush x:Key="Aurorix.Theme.Brush.Border" Color="{StaticResource Aurorix.Theme.Color.Border}" />
    <SolidColorBrush x:Key="Aurorix.Theme.Brush.Accent" Color="{StaticResource Aurorix.Theme.Color.Accent}" />
    <SolidColorBrush x:Key="Aurorix.Theme.Brush.OnAccent" Color="{StaticResource Aurorix.Theme.Color.OnAccent}" />
    <SolidColorBrush x:Key="Aurorix.Theme.Brush.Focus" Color="{StaticResource Aurorix.Theme.Color.Focus}" />
    <SolidColorBrush x:Key="Aurorix.Theme.Brush.Selection" Color="{StaticResource Aurorix.Theme.Color.Selection}" />
    <SolidColorBrush x:Key="Aurorix.Theme.Brush.Disabled" Color="{StaticResource Aurorix.Theme.Color.Disabled}" />

    <x:String x:Key="Aurorix.Theme.Typography.FontFamily">Segoe UI Variable Text</x:String>
    <x:Double x:Key="Aurorix.Theme.Typography.BodySize">13</x:Double>
    <x:Double x:Key="Aurorix.Theme.Typography.CaptionSize">11</x:Double>
    <x:Double x:Key="Aurorix.Theme.Typography.HeadingSize">18</x:Double>
    <x:Double x:Key="Aurorix.Theme.Typography.TitleSize">30</x:Double>
    <x:String x:Key="Aurorix.Theme.Typography.BodyWeight">Normal</x:String>

    <x:Double x:Key="Aurorix.Theme.Spacing.Xs">4</x:Double>
    <x:Double x:Key="Aurorix.Theme.Spacing.Sm">8</x:Double>
    <x:Double x:Key="Aurorix.Theme.Spacing.Md">12</x:Double>
    <x:Double x:Key="Aurorix.Theme.Spacing.Lg">18</x:Double>
    <x:Double x:Key="Aurorix.Theme.Spacing.Xl">28</x:Double>
    <x:Double x:Key="Aurorix.Theme.Shape.ControlCornerRadius">9</x:Double>
    <x:Double x:Key="Aurorix.Theme.Shape.CardCornerRadius">14</x:Double>
    <x:Double x:Key="Aurorix.Theme.Shape.PanelCornerRadius">18</x:Double>
    <CornerRadius x:Key="Aurorix.Theme.Shape.NavigationCornerRadius">8</CornerRadius>
    <x:Double x:Key="Aurorix.Theme.Elevation.Panel">8</x:Double>
    <x:Double x:Key="Aurorix.Theme.Opacity.Surface">0.94</x:Double>
    <x:Double x:Key="Aurorix.Theme.Opacity.Border">0.52</x:Double>
    <x:Double x:Key="Aurorix.Theme.Opacity.Disabled">0.45</x:Double>
    <x:Double x:Key="Aurorix.Theme.Blur.Surface">18</x:Double>
    <x:Double x:Key="Aurorix.Theme.Vibrancy.Surface">0.6</x:Double>
    <x:String x:Key="Aurorix.Theme.Material.Surface">mica</x:String>

    <x:Boolean x:Key="Aurorix.Theme.Motion.Enabled">true</x:Boolean>
    <x:Double x:Key="Aurorix.Theme.Motion.FastDurationMs">120</x:Double>
    <x:Double x:Key="Aurorix.Theme.Motion.NormalDurationMs">200</x:Double>
    <x:Double x:Key="Aurorix.Theme.Motion.SlowDurationMs">320</x:Double>
    <x:Double x:Key="Aurorix.Theme.Focus.RingThickness">2</x:Double>
    <x:Boolean x:Key="Aurorix.Theme.Accessibility.TransparencyAllowed">true</x:Boolean>
    <x:Boolean x:Key="Aurorix.Theme.Accessibility.FocusVisible">true</x:Boolean>

    <!-- Compatibility aliases for the fixture page. New XAML should use the
         semantic resources above. -->
    <Color x:Key="AurorixCanvasColor">#DDF1F3</Color>
    <Color x:Key="AurorixInkColor">#172026</Color>
    <Color x:Key="AurorixMutedInkColor">#647078</Color>
    <Color x:Key="AurorixGlassBorderColor">#841B2529</Color>
    <SolidColorBrush x:Key="AurorixCanvasBrush" Color="{StaticResource Aurorix.Theme.Color.Canvas}" />
    <SolidColorBrush x:Key="AurorixInkBrush" Color="{StaticResource Aurorix.Theme.Color.Ink}" />
    <SolidColorBrush x:Key="AurorixMutedInkBrush" Color="{StaticResource Aurorix.Theme.Color.MutedInk}" />
    <SolidColorBrush x:Key="AurorixGlassBrush" Color="{StaticResource Aurorix.Theme.Color.Surface}" />
    <SolidColorBrush x:Key="AurorixGlassBorderBrush" Color="{StaticResource Aurorix.Theme.Color.Border}" />
</ResourceDictionary>
